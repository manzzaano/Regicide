# Copia este fichero a .env y cambia los dos valores.
DB_PASSWORD=cambia-esta-contrasena
# Firma los tokens de sesión: al menos 32 caracteres.
JWT_SECRET=cambia-este-secreto-por-uno-de-32-caracteres-o-mas
# Opcional: clave de la API de Resend para enviar los correos de recuperación de contraseña.
RESEND_API_KEY=
# Solo en el servidor (docker-compose.prod.yml): el dominio para el que Caddy pide el certificado.
DOMINIO=regicide.leosoftware.dev
